const NS_IN_MS: number = 1000
const MS_IN_SEC: number = 1000
const MS_IN_MIN: number = 60000

let MSH: number = 0
MSH = MS_IN_MIN * 60
const MS_IN_HOUR:number = MSH
const MS_IN_DAY: number = MSH * 24
const MS_IN_WEEK: number = MS_IN_DAY * 7

export const NumberOfMS = ['NS_IN_MS', 'MS_IN_SEC', 'MS_IN_MIN', 'MS_IN_HOUR', 'MS_IN_DAY', 'MS_IN_WEEK'] as const
